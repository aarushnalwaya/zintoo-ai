# ─── Zintoo AI — environment variables ───
# Copy this file to `.env` and the app WILL read it automatically at startup
# (app/settings.py parses it; no python-dotenv needed).
# This file is READ only if named exactly `.env` in the project root.
# Real shell environment variables always override .env.
# All are OPTIONAL for local dev (safe defaults apply). In PRODUCTION you
# should at minimum set ZINTOO_SECRET_KEY.

# Runtime mode: development | production
ZINTOO_ENV=development

# HMAC secret used to sign session tokens. MUST be set in production, otherwise
# a random per-boot secret is used and all tokens are invalidated on restart.
# Generate one:  python -c "import secrets; print(secrets.token_hex(32))"
ZINTOO_SECRET_KEY=

# How long a login token stays valid, in seconds (default 12h).
ZINTOO_TOKEN_TTL=43200

# Where the SQLite DB + runtime data live. Point at a mounted disk for durable
# state on paid Render plans. Free tier: leave default (ephemeral, re-seeds).
ZINTOO_DATA_DIR=
ZINTOO_DB_PATH=

# Structured JSON logs (recommended in production; pretty logs locally).
ZINTOO_JSON_LOGS=false
ZINTOO_LOG_LEVEL=INFO

# CORS: comma-separated allowed origins. Empty = same-origin only (dashboard is
# served by this app, so you usually don't need this).
ZINTOO_CORS_ORIGINS=

# Per-IP rate limiting.
ZINTOO_RATE_LIMIT=true
ZINTOO_RATE_LIMIT_RPS=20
ZINTOO_RATE_LIMIT_BURST=40

# Weather regressor (Open-Meteo, free, no key). Disable to skip network calls.
ZINTOO_WEATHER_ENABLED=true
ZINTOO_WEATHER_TIMEOUT=4.0
ZINTOO_WEATHER_CACHE_TTL=900

# ─── Vision: image classification + visual search (see VISION.md) ────
# Master switch. OFF by default: onnxruntime + model add ~150-250 MB RSS,
# which can OOM a 512 MB instance. Turn on deliberately, after measuring.
ZINTOO_VISION_ENABLED=false
# Load + warm the ORT session at boot (slower start, no first-request spike).
ZINTOO_VISION_PRELOAD=false
# ORT intra-op threads. Keep at 1 on shared/fractional vCPU instances.
ZINTOO_VISION_THREADS=1
# Where fashion_classifier.onnx, labels.json, catalog_embeddings.npy live.
ZINTOO_MODELS_DIR=

# ─── Training only (never set on the web server) ─────────────────────
# Folder containing styles.csv and images/ from the Kaggle dataset.
ZINTOO_DATASET_DIR=
ZINTOO_BACKBONE=mobilenet_v3_small
ZINTOO_EPOCHS=12
ZINTOO_BATCH_SIZE=64

# Optional: serve real product photos at /images/{product_id}.jpg
# Point at a folder of {id}.jpg files. The RESIZED cache (~300 MB) is ideal;
# the raw 25 GB dataset is not. If unset, the dashboard uses placeholders.
ZINTOO_IMAGES_DIR=
